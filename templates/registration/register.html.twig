{% extends 'base.html.twig' %}

{% block title %}Inscription - FigurineVie{% endblock %}

{% block body %}
    <section class="container py-4 form-page form-page-narrow">
        <div class="card">
            <div class="card-body p-4 p-md-5">
                <h1 class="h2 mb-1">S'inscrire</h1>
                <p class="text-secondary mb-4">Créez votre compte pour partager vos figurines.</p>

                {{ form_start(registrationForm) }}
                    <div class="row">
                        <div class="col-md-6">{{ form_row(registrationForm.firstname) }}</div>
                        <div class="col-md-6">{{ form_row(registrationForm.lastname) }}</div>
                    </div>
                    {{ form_row(registrationForm.email) }}
                    {{ form_row(registrationForm.imageName) }}
                    {{ form_row(registrationForm.plainPassword) }}

                    <button class="btn btn-brand w-100 mt-2" type="submit">
                        <i class="bi bi-person-plus me-1"></i>Créer mon compte
                    </button>
                {{ form_end(registrationForm) }}

                <p class="text-center small text-secondary mt-4 mb-0">
                    Déjà inscrit ? <a href="{{ path('app_login') }}">Se connecter</a>
                </p>
            </div>
        </div>
    </section>
{% endblock %}

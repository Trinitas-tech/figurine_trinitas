{% extends 'base.html.twig' %}

{% block title %}Accueil - FigurineVie{% endblock %}

{% block body %}
    {# ---------- Bandeau principal : panneau sombre + panneau blanc (style portfolio) ---------- #}
    <section class="container pt-4 pb-5">
        <div class="hero">
            <div class="hero-copy">
                <p class="eyebrow">Communauté de collectionneurs</p>
                <h1>Donnez vie à votre collection</h1>
                <p class="role">Figurines · Photos · Partage</p>
                <p class="lead">
                    FigurineVie est l'endroit où partager les photos de vos figurines,
                    découvrir les pièces des autres collectionneurs et organiser votre vitrine en ligne.
                </p>
                <div class="d-flex flex-wrap gap-3 mt-4">
                    {% if app.user %}
                        <a class="btn btn-brand btn-lg" href="{{ path('app_figurine_index') }}">
                            <i class="bi bi-grid-3x3-gap me-2"></i>Voir les figurines
                        </a>
                        <a class="btn btn-warning btn-lg" href="{{ path('app_figurine_create') }}">
                            <i class="bi bi-plus-circle me-2"></i>Ajouter une figurine
                        </a>
                    {% else %}
                        <a class="btn btn-brand btn-lg" href="{{ path('app_register') }}">
                            <i class="bi bi-person-plus me-2"></i>Rejoindre la communauté
                        </a>
                        <a class="btn btn-warning btn-lg" href="{{ path('app_login') }}">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Se connecter
                        </a>
                    {% endif %}
                </div>
            </div>

            <aside class="hero-side">
                <div class="hero-collage">
                    <img src="https://img.magnific.com/vecteurs-premium/conception-carte-drapeau-national-du-burundi-illustration-du-drapeau-pays-du-burundi-interieur-carte_591091-563.jpg" alt="Carte du Burundi aux couleurs du drapeau national" referrerpolicy="no-referrer">
                    <img src="https://commons.wikimedia.org/wiki/Special:FilePath/Statut_du_prince_Louis_Rwagasore.jpg?width=900" alt="Statue du prince Louis Rwagasore" referrerpolicy="no-referrer">
                    <img src="https://www.burundi-forum.org/wp-content/uploads/2019/10/bdi_burundi_ndadaye_2019.jpeg" alt="Portrait de Melchior Ndadaye, héros de la démocratie au Burundi" referrerpolicy="no-referrer">
                </div>
                <div class="fact">
                    <small>Collections</small>
                    <b>Star Wars · Marvel · Pokémon · Ghibli · LEGO</b>
                </div>
            </aside>
        </div>
    </section>

    {# ---------- Comment ça marche ---------- #}
    <section class="container pb-5">
        <div class="section-head">
            <h2>Comment ça marche ?</h2>
            <p>Trois étapes pour mettre votre collection en valeur et la partager avec la communauté.</p>
        </div>
        <div class="card">
            <div class="card-body p-4 p-md-5">
                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="feature-card">
                            <div class="feature-icon mb-3"><i class="bi bi-person-plus"></i></div>
                            <h3>1. Créez votre compte</h3>
                            <p class="text-secondary mb-0">Inscrivez-vous en quelques secondes avec votre email et une photo de profil.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="feature-card">
                            <div class="feature-icon mb-3"><i class="bi bi-camera"></i></div>
                            <h3>2. Partagez vos figurines</h3>
                            <p class="text-secondary mb-0">Ajoutez une photo, un titre et une description pour chaque pièce de votre collection.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="feature-card">
                            <div class="feature-icon mb-3"><i class="bi bi-collection"></i></div>
                            <h3>3. Explorez la communauté</h3>
                            <p class="text-secondary mb-0">Parcourez la galerie des membres et gérez vos propres figurines à tout moment.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ---------- Aperçu de la galerie ---------- #}
    <section class="container pb-5">
        <div class="section-head">
            <h2>Un aperçu de la galerie</h2>
            <p>Star Wars, Marvel, Pokémon, Ghibli... toutes les collections sont les bienvenues.</p>
        </div>
        <div class="card">
            <div class="card-body p-4 p-md-5">
                <div class="home-strip mb-4">
                    <img src="https://images.unsplash.com/photo-1609372332255-611485350f25?auto=format&fit=crop&w=400&q=70" alt="Figurine Pikachu" loading="lazy" referrerpolicy="no-referrer">
                    <img src="https://images.unsplash.com/photo-1601814933824-fd0b574dd592?auto=format&fit=crop&w=400&q=70" alt="Figurine Grogu" loading="lazy" referrerpolicy="no-referrer">
                    <img src="https://images.unsplash.com/photo-1608889335941-32ac5f2041b9?auto=format&fit=crop&w=400&q=70" alt="Figurine Deadpool" loading="lazy" referrerpolicy="no-referrer">
                    <img src="https://images.unsplash.com/photo-1559535332-db9971090158?auto=format&fit=crop&w=400&q=70" alt="Figurine Groot" loading="lazy" referrerpolicy="no-referrer">
                    <img src="https://images.unsplash.com/photo-1593085512500-5d55148d6f0d?auto=format&fit=crop&w=400&q=70" alt="Figurine Minion" loading="lazy" referrerpolicy="no-referrer">
                    <img src="https://images.unsplash.com/photo-1611457194403-d3aca4cf9d11?auto=format&fit=crop&w=400&q=70" alt="Figurine Totoro" loading="lazy" referrerpolicy="no-referrer">
                </div>
                <div class="d-flex flex-wrap gap-3">
                    {% if app.user %}
                        <a class="btn btn-dark" href="{{ path('app_figurine_index') }}">Voir toutes les figurines</a>
                    {% else %}
                        <a class="btn btn-dark" href="{{ path('app_login') }}">Se connecter pour tout voir</a>
                        <a class="btn btn-neo" href="{{ path('app_register') }}">Créer un compte</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>
{% endblock %}

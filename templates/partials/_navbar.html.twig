{#
    Barre de navigation (verre dépoli)
    - Non connecté : Logo, Accueil, S'inscrire, Se connecter
    - Connecté     : Logo, Accueil, Créer une figurine, Mon Profil, Déconnexion
#}
<nav class="navbar navbar-expand-lg navbar-light navbar-glass sticky-top">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" href="{{ path('app_home') }}">
            <span class="brand-logo">F</span>
            <span>FigurineVie</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Ouvrir le menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNavbar">
            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                <li class="nav-item">
                    <a class="nav-link {{ app.current_route == 'app_home' ? 'active' }}" href="{{ path('app_home') }}">
                        <i class="bi bi-house-door me-1"></i>Accueil
                    </a>
                </li>
                {% if app.user %}
                    <li class="nav-item">
                        <a class="nav-link {{ app.current_route == 'app_figurine_index' ? 'active' }}" href="{{ path('app_figurine_index') }}">
                            <i class="bi bi-grid-3x3-gap me-1"></i>Figurines
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.current_route == 'app_figurine_create' ? 'active' }}" href="{{ path('app_figurine_create') }}">
                            <i class="bi bi-plus-circle me-1"></i>Créer une figurine
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.current_route starts with 'app_account' ? 'active' }}" href="{{ path('app_account') }}">
                            <img class="nav-avatar me-1" src="{{ app.user.imageName }}" alt="" referrerpolicy="no-referrer"
                                 onerror="this.onerror=null;this.src='https://ui-avatars.com/api/?name={{ app.user.fullName|url_encode }}&background=3f6fd8&color=fff&size=64';">
                            Mon Profil
                        </a>
                    </li>
                    <li class="nav-item ms-lg-2">
                        <a class="btn btn-neo btn-sm" href="{{ path('app_logout') }}">
                            <i class="bi bi-box-arrow-right me-1"></i>Déconnexion
                        </a>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="nav-link {{ app.current_route == 'app_register' ? 'active' }}" href="{{ path('app_register') }}">
                            <i class="bi bi-person-plus me-1"></i>S'inscrire
                        </a>
                    </li>
                    <li class="nav-item ms-lg-2">
                        <a class="btn btn-brand btn-sm" href="{{ path('app_login') }}">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Se connecter
                        </a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>
